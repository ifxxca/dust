APP_NAME="Retail Pickup"
MOBILE_PUSH_ENABLED=false
FCM_PROJECT_ID=
FCM_CREDENTIALS_PATH=
PICKUP_TIMEZONE=Asia/Jakarta
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8010
SERVER_PORT=8010
LOCAL_WEB_DRIVER=artisan
LOCAL_WEB_PHP_WORKERS=4
LOCAL_WEB_FASTCGI_PORT=0
LOCAL_WEB_NGINX_PATH=
JNE_MONITORING_SUMMARY_CACHE_SECONDS=15
JNE_MONITORING_CACHE_STORE=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
TELESCOPE_ENABLED=false

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_TIMEOUT=30
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

PICKUP_TIMEZONE=Asia/Jakarta
# Enable only after the operational rule is approved: today or catchup_7_days.
PICKUP_GENERATION_POLICY=
PICKUP_ALLOW_INCOMPLETE_CUSTOMER=false
# Set email only after selecting SMTP as the receipt provider/channel.
PICKUP_RECEIPT_CHANNEL=
WAHA_BASE_URL=
WAHA_API_KEY=
WAHA_SEND_SEEN=true
WAHA_RECIPIENT_HOURLY_LIMIT=8
WAHA_RECIPIENT_DAILY_LIMIT=24
PICKUP_MULTIPLE_EMAIL_RECIPIENTS=false
PICKUP_EMAIL_RECIPIENT_LIMIT=5

# Dedicated JNE report worker (same token/id in workers/jne-report/.env).
JNE_REPORT_WORKER_TOKEN=
JNE_REPORT_WORKER_ID=jne-report-1
JNE_APEX_POOL_ENABLED=true
JNE_APEX_POOL_PAUSED=false
JNE_APEX_CONCURRENCY=5
# Activate only after the retry scheduling migration and compatible worker rollout.
JNE_REPORT_AUTOMATIC_RETRY_ENABLED=false
HYBRID_AUTO_RETRY_MAX=1
HYBRID_RETRY_DELAY_SECONDS=120
HYBRID_RETRY_SECOND_DELAY_SECONDS=300
JNE_CATEGORY_MARKERS_ENABLED=false
JNE_REPORT_LEASE_SECONDS=300
JNE_REPORT_MAX_FILE_KB=20480
JNE_REPORT_MODE=P
JNE_REPORT_SOURCE_TIMEZONE=Asia/Jakarta
# Optional persistent private directory outside the web root.
# JNE_REPORT_STORAGE_PATH=
PICKUP_AUTOMATION_ENABLED=false
PICKUP_AWB_SEND_ENABLED=false
CASHLESS_ENTRY_ENABLED=false
CASHLESS_REPORT_CONFIRMATION_ENABLED=false
CASHLESS_HANDOVER_LOCK_ENABLED=true
CASHLESS_PER_USER_ACCOUNTS=true
