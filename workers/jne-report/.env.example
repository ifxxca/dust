# Laravel root URL; use HTTPS outside local development.
RETAIL_OPERATIONS_URL=http://localhost:8000
JNE_REPORT_WORKER_TOKEN=
JNE_REPORT_WORKER_ID=jne-report-1
APEX_LOGIN_URL=
APEX_USERNAME=
APEX_PASSWORD=
# Optional for friendly APEX login URLs: full same-origin endpoint ending in /f.
APEX_BASE_URL=
APEX_APP_ID=
# These values must be confirmed against the authorized live form.
APEX_DATE_FORMAT=
APEX_HISTORY_DATE_FORMAT=
APEX_TIMEZONE=Asia/Jakarta
# Optional exact selectors, only after inspecting the live page.
APEX_PROCESS_SELECTOR=
APEX_SUBMISSION_SUCCESS_SELECTOR=
# Extra form controls, e.g. {"#observed-control":"confirmed-value"}.
APEX_EXTRA_FIELDS_JSON={}
JNE_WORKER_DATA_DIR=../../storage/app/private/jne-worker
JNE_NAVIGATION_TIMEOUT_MS=30000
JNE_REPORT_TIMEOUT_MS=1200000
JNE_JOB_TIMEOUT_MS=1500000
JNE_DOWNLOAD_TIMEOUT_MS=120000
JNE_API_TIMEOUT_MS=60000
JNE_POLL_INTERVAL_MS=10000
JNE_CLAIM_INTERVAL_MS=5000
JNE_MAX_FILE_BYTES=20971520
JNE_CLOCK_SKEW_MS=120000

# Hybrid accounts; copy these settings to the ignored .env.hybrid file.
HYBRID_ROBERTO_LOGIN_URL=
HYBRID_ROBERTO_USERNAME=
HYBRID_ROBERTO_PASSWORD=
HYBRID_NURALAMT_LOGIN_URL=
HYBRID_NURALAMT_USERNAME=
HYBRID_NURALAMT_PASSWORD=
# Optional absolute directory for downloaded Hybrid reports.
HYBRID_OUTPUT_DIR=
